<Window x:Class="LiquidIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquid Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Всё выравнивается по верхней кромке: остров вырастает из неё. -->
    <Window.Resources>
        <!-- Кнопки транспорта: только значок, без рамки и подложки. Подсветка
             под курсором и нажатие показываются прозрачностью. -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid x:Name="IslandLayer" VerticalAlignment="Top">
            <!-- Сама фигура. Заливка чёрная сверху и прозрачная снизу — там
                 проступает акрил окна, и получается переход, а не плашка. -->
            <Path x:Name="IslandBody" Stretch="None">
                <Path.Fill>
                    <LinearGradientBrush x:Name="BodyFill" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="FillTop" Color="Black" Offset="0" />
                        <GradientStop x:Name="FillMid" Color="Black" Offset="0.44" />
                        <GradientStop x:Name="FillBottom" Color="#00000000" Offset="0.72" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <SolidColorBrush x:Name="RimBrush" Color="#29FFFFFF" />
                </Path.Stroke>
            </Path>

            <!-- Содержимое: карточка трека или плашка события. -->
            <Grid x:Name="ContentLayer" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="MediaCard" Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ArtworkBox" Grid.Column="0"
                            Width="18" Height="18" CornerRadius="5"
                            VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ArtworkScale" CenterX="9" CenterY="9" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                        </Border.Background>
                        <!-- Видно, когда обложки нет: приложение может её не
                             отдавать, и пустой квадрат читался бы как поломка. -->
                        <TextBlock x:Name="ArtworkFallback"
                                   Text="&#xE8D6;"
                                   FontFamily="Segoe Fluent Icons"
                                   Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel x:Name="TextColumn" Grid.Column="1"
                                VerticalAlignment="Center" Margin="8,0,6,0">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="TextScale" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="TitleText"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="10"
                                   Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="Waveform" Grid.Column="2"
                                Orientation="Horizontal" VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="PlayerExtras" Grid.Row="1"
                            VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <Border Height="3" CornerRadius="1.5" Background="#38FFFFFF"
                                VerticalAlignment="Center" />
                        <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5"
                                Background="#D9FFFFFF"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="ElapsedText" HorizontalAlignment="Left"
                                   FontFamily="Segoe UI Variable Text" FontSize="9"
                                   Foreground="#99FFFFFF" />
                        <TextBlock x:Name="RemainingText" HorizontalAlignment="Right"
                                   FontFamily="Segoe UI Variable Text" FontSize="9"
                                   Foreground="#99FFFFFF" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PreviousButton" Content="&#xE892;" Margin="0,0,20,0" />
                        <Button x:Name="PlayPauseButton" Content="&#xE768;" />
                        <Button x:Name="NextButton" Content="&#xE893;" Margin="20,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="HudCard" Grid.Row="0" Grid.RowSpan="2"
                      Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HudGlyph" Grid.Column="0"
                               FontFamily="Segoe Fluent Icons" FontSize="12"
                               Foreground="White" VerticalAlignment="Center" />

                    <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="10,0"
                            Background="#38FFFFFF" VerticalAlignment="Center">
                        <Border x:Name="HudFill" HorizontalAlignment="Left"
                                CornerRadius="2" Background="#D9FFFFFF" />
                    </Border>

                    <TextBlock x:Name="HudReadout" Grid.Column="2" Width="34"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right" Foreground="White"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Капсула с точками вынесена из потока разметки и сдвигается вручную:
             в потоке её положение зависело бы от размера острова, и при
             сворачивании она уезжала бы вбок вместе с ним. -->
        <Border x:Name="DotsCapsule" CornerRadius="10" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DotsOffset" />
            </Border.RenderTransform>
            <StackPanel x:Name="Dots" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
